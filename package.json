{
  "name": "pakistan-cities-area-block-api",
  "version": "1.1.0",
  "description": "A read-only JSON API for Pakistan cities, areas, and blocks.",
  "type": "module",
  "main": "./sdk/location-api-client.js",
  "module": "./sdk/location-api-client.js",
  "types": "./sdk/location-api-client.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/location-api-client.d.ts",
      "import": "./sdk/location-api-client.js",
      "require": "./sdk/location-api-client.cjs"
    }
  },
  "bin": {
    "pakistan-location-api": "./server.mjs"
  },
  "files": ["data", "sdk", "php-api", "public", "server.mjs", "openapi.json", "README.md", "LICENSE"],
  "scripts": {
    "start": "node server.mjs",
    "test": "node scripts/validate-data.mjs && node scripts/test-integrations.mjs",
    "test:data": "node scripts/validate-data.mjs",
    "test:integrations": "node scripts/test-integrations.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssanaullahrais/Pakistan-Cities-Area-Block-API.git"
  },
  "keywords": ["pakistan", "cities", "areas", "blocks", "location", "api", "sdk"],
  "license": "MIT"
}
